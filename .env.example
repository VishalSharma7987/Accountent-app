# Copy to .env and fill in. NEVER commit .env.
# Supabase dashboard -> Project -> Connect -> Session pooler string (port 5432).
# If the password contains special characters (@ # / : ?), percent-encode them (@ -> %40).

# One Supabase project, two schemas. Both URLs are the SAME string:
#   DATABASE_URL       -> schema public           (dev data)
#   TEST_DATABASE_URL  -> schema ledgermind_test  (automated tests only; the code selects the schema, not the URL)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
TEST_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
