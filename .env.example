# Copy to .env and fill in. NEVER commit .env.
# Supabase dashboard -> Project -> Connect -> Session pooler string (port 5432).
# If the password contains special characters (@ # / : ?), percent-encode them (@ -> %40).

# One Supabase project, two schemas. Both URLs are the SAME string:
#   DATABASE_URL       -> schema public           (dev data)
#   TEST_DATABASE_URL  -> schema ledgermind_test  (automated tests only; the code selects the schema, not the URL)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
TEST_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Phase 7 (documents and AI) - all optional; nothing AI-related runs without them.
# Folder for uploaded invoices / statements: absolute path OUTSIDE the repository, e.g. C:\LedgerMindFiles
DOCUMENT_STORE_DIR=
# OpenRouter (only when AI reading is switched on for a client): key from openrouter.ai and a model name from its model list
OPENROUTER_API_KEY=
LLM_MODEL=
# Optional: minimum confidence below which an extracted field is flagged (default 0.85); upload size limit in bytes (default 15 MB)
# AI_MIN_CONFIDENCE=0.85
# MAX_UPLOAD_BYTES=15728640
